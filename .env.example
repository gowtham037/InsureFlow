# InsureFlow Environment Configuration Template
# Copy this template to .env: cp .env.example .env

ENVIRONMENT=production

# Database Credentials (use strong passwords in production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=insureflow
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@db:5432/insureflow

# Fallback SQLite Database (for offline / non-container testing)
SQLITE_FALLBACK_URL=sqlite:///./insureflow.db

# Deterministic Generator Seed (fixed for reproducible audits)
DATA_GEN_SEED=20261022

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3001
VITE_API_BASE_URL=http://localhost:8000/api
