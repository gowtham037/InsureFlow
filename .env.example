# InsureFlow Environment Configuration Template
# Copy this template to .env: cp .env.example .env

ENVIRONMENT=production

# Database Credentials (ready for Docker out-of-the-box; change for production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insureflow
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Container Database Connection (used by Docker Compose backend)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/insureflow

# Local Development Database Connection (uncomment if running backend on host outside Docker)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/insureflow

# Fallback SQLite Database (for offline / non-container testing)
SQLITE_FALLBACK_URL=sqlite:///./insureflow.db

# Deterministic Generator Seed (fixed for reproducible audits)
DATA_GEN_SEED=20261022
AUTO_SEED_ON_STARTUP=true

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3001
VITE_API_BASE_URL=http://localhost:8000/api
